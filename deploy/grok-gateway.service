[Unit]
Description=Grok account-rotating [OI] gateway
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lyravein/Documents/Playground/project/grok-gateway
EnvironmentFile=/home/lyravein/.config/grok-gateway/env
ExecStart=/usr/bin/python3 /home/lyravein/Documents/Playground/project/grok-gateway/gateway.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/lyravein/.local/state/grok-gateway

[Install]
WantedBy=default.target
