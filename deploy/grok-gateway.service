[Unit]
Description=Grok account-rotating OpenAI gateway
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/grok-gateway
EnvironmentFile=%h/.config/grok-gateway/env
ExecStart=/usr/bin/python3 %h/grok-gateway/gateway.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/grok-gateway

[Install]
WantedBy=default.target
